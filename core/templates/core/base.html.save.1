{% load static %}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}نتائج مسابقة القرآن{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{% static 'core/css/style.css' %}">
    <link rel="icon" type="image/jpeg" href="{% static 'core/images/logo.jpg' %}">
    {% block extra_head %}{% endblock %}
</head>
<body>
    <div class="bg-pattern"></div>
    <div class="bg-rays"></div>

    <div class="page-wrapper">
        <header class="site-header">
            <div class="logo-wrap">
                <img src="{% static 'core/images/logo.png' %}" alt="شعار جمعية الخلفاء الراشدين" class="logo">
            </div>
            <h1 class="org-name">الخلفاء الراشدين</h1>
            <p class="org-subtitle">لتحفيظ القرآن الكريم وعلومه</p>	
		<div style="margin-top: 1.25rem;">
    <a href="{% url 'register' %}" class="btn-search" style="display:inline-flex; width:auto; padding: 0.65rem 1.5rem; font-size: 0.95rem;">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" style="width:18px;height:18px;">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        تسجيل استمارة جديدة
    </a>
		</div>	

        </header>

        <main class="main-content">
            <div class="container">
                {% block content %}{% endblock %}
            </div>
        </main>

        <footer class="site-footer">
            <div class="ornament"><span class="ornament-diamond"></span></div>
            <p>جميع الحقوق محفوظة &copy; {% now "Y" %} — جمعية الخلفاء الراشدين</p>
            <p class="developer-credit">تطوير: <a href="https://ahmed-medhat.site" target="_blank" rel="noopener">أحمد مدحت</a></p>
        </footer>
    </div>

    {% block extra_js %}{% endblock %}
</body>
</html>
